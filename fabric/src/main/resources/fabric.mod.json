{
	"schemaVersion": 1,
	"id": "elemental_wizards_rpg",
	"version": "${version}",
	"name": "Elemental Wizards (RPG Series Plus)",
	"description": "Master the elements to overcome your foes! Spell Engine Add-On",
	"authors": [
		"Fichte"
	],
	"contact": {
		"sources": "https://github.com/ProfessorFichte"
	},
	"license": "ARR",
	"icon": "icon.png",
	"environment": "*",
	"entrypoints": {
		"client":[
			"com.elemental_wizards.fabric.client.FabricClient"
		],
		"main": [
			"com.elemental_wizards.fabric.FabricMod"
		],
		"fabric-datagen": [
			"net.elemental_wizards_rpg.ElementalWizardsRPGClassDataGenerator"
		]
	},
	"mixins": [
		"elemental_wizards_rpg.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${fabric_loader_version}",
		"minecraft": ">=${minecraft_compat_version}",
