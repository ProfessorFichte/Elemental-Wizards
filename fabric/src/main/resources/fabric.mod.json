{
	"schemaVersion": 1,
	"id": "elemental_wizards_rpg",
	"version": "${version}",
	"name": "Elemental Wizards",
	"description": "Master the elements to overcome your foes! Spell Engine Add-On",
	"authors": [
		"Fichte"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/elemental-wizards-rpg",
		"sources": "https://github.com/ProfessorFichte/Elemental-Wizards",
		"issues": "https://github.com/ProfessorFichte/Elemental-Wizards/issues"
	},
	"license": "ARR",
	"icon": "icon.png",
	"environment": "*",
	"entrypoints": {
		"client":[
			"com.elemental_wizards.fabric.client.FabricClient"
		],
		"main": [
			"com.elemental_wizards.fabric.FabricMod"
		],
		"fabric-datagen": [
			"net.elemental_wizards_rpg.ElementalWizardsRPGClassDataGenerator"
		]
	},
	"mixins": [
		"elemental_wizards_rpg.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${fabric_loader_compat_version}",
		"minecraft": ">=${minecraft_compat_version}",
		"java": ">=21",
		"fabric-api": "*",
		"armor_model_api": "*",
		"spell_engine": ">=${spell_engine_version}",
		"spell_power": ">=${spell_power_version}",
		"mrpg_lib": ">=${more_rpg_library_version}",
		"wizards": "*"
	},
	"suggests": {
		"bettercombat": "*",
		"armory_rpgs": "*",
		"arsenal": "*",
		"mrpgc_skill_tree": "*"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.discord": "https://discord.gg/AShKd5XrTu",
				"modmenu.kofi": "https://ko-fi.com/fichteee",
				"modmenu.modrinth": "https://modrinth.com/mod/elemental-wizards-rpg",
				"modmenu.curseforge": "https://www.curseforge.com/minecraft/mc-mods/elemental-wizards-rpg-class"
			}
		}
	}
}